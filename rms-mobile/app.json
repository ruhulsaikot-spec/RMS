{
  "expo": {
    "name": "RMS",
    "slug": "rms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "rms",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wyzetech.rms"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030B1F",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.wyzetech.rms",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0891b2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b726946-d3d1-4ffe-95bd-d64e22629224"
      }
    },
    "owner": "saikots-team"
  }
}
